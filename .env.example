# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env dosyası depoya işlenmez.
POSTGRES_DB=varlikenvanteri
POSTGRES_USER=varlik
POSTGRES_PASSWORD=degistir-beni
# Host tarafi port. Makinede zaten bir PostgreSQL calisiyorsa degistirin.
POSTGRES_PORT=5433
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Ilk kurulumda olusturulacak yonetici hesabi.
# YONETICI_SIFRESI bos birakilirsa rastgele uretilir ve uygulama gunlugune yazilir.
YONETICI_KULLANICI_ADI=admin
YONETICI_SIFRESI=

# Arayüz ve kültür
UYGULAMA_ADI=Varlık Envanteri
KULTUR=tr-TR
OTURUM_SURESI_DK=60
