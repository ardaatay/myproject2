@model Dto.Loglar.IslemLogDetayDto

@{
	ViewData["Title"] = "İşlem Logu";
}

<div class="container-fluid">
	<h1 class="mt-4">İşlem Logu #@Model.Id</h1>

	<div class="card mb-4">
		<div class="card-header d-flex justify-content-between align-items-center">
			<span>@Model.Modul · @Model.Islem</span>
			<span class="badge @(Model.Basarili ? "bg-success" : "bg-danger")">@Model.DurumStr</span>
		</div>
		<div class="card-body">
			<dl class="row mb-0">
				<dt class="col-sm-3">Tarih</dt>
				<dd class="col-sm-9">@Model.Tarih.ToString("dd.MM.yyyy HH:mm:ss")</dd>

				<dt class="col-sm-3">Kullanıcı</dt>
				<dd class="col-sm-9">@Model.Kullanici</dd>

				<dt class="col-sm-3">Süre</dt>
				<dd class="col-sm-9">@Model.SureMs ms</dd>

				<dt class="col-sm-3">İstek yolu</dt>
				<dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Yol) ? "—" : Model.Yol)</dd>

				<dt class="col-sm-3">IP adresi</dt>
				<dd class="col-sm-9">@(string.IsNullOrEmpty(Model.IpAdresi) ? "—" : Model.IpAdresi)</dd>

				@if (!string.IsNullOrEmpty(Model.HataKodu))
				{
					<dt class="col-sm-3">Hata kodu</dt>
					<dd class="col-sm-9">
						<code style="user-select: all">@Model.HataKodu</code>
						@if (Model.HataLogId is { } hataId)
						{
							<a asp-controller="HataLoglari" asp-action="Detay" asp-route-id="@hataId"
							   class="btn btn-sm btn-outline-danger ms-2">
								<i class="bi bi-bug me-1"></i>Hata kaydına git
							</a>
						}
						else
						{
							<span class="text-muted small ms-2">Bu koda bağlı bir hata kaydı bulunamadı.</span>
						}
					</dd>
				}
			</dl>
		</div>
	</div>

	@if (!string.IsNullOrEmpty(Model.Hata))
	{
		<div class="card mb-4 border-danger">
			<div class="card-header text-danger">Hata mesajı</div>
			<div class="card-body">
				<pre class="mb-0" style="white-space: pre-wrap; word-break: break-word">@Model.Hata</pre>
			</div>
		</div>
	}

	<div class="card mb-4">
		<div class="card-header">Parametreler</div>
		<div class="card-body">
			<pre class="mb-0" style="white-space: pre-wrap; word-break: break-word">@(string.IsNullOrEmpty(Model.Parametreler) ? "—" : Model.Parametreler)</pre>
		</div>
	</div>

	<div class="card mb-4">
		<div class="card-header">Dönüş değeri</div>
		<div class="card-body">
			<pre class="mb-0" style="white-space: pre-wrap; word-break: break-word">@(string.IsNullOrEmpty(Model.DonusDegeri) ? "—" : Model.DonusDegeri)</pre>
		</div>
	</div>

	<a asp-action="Index" class="btn btn-secondary mb-4">Listeye Dön</a>
</div>
