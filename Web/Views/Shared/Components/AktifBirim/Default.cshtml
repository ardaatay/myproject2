@model Web.ViewModels.AktifBirimViewModel

@{
    Layout = null;
}

@if (!string.IsNullOrEmpty(Model.AktifBirimAdi))
{
    <a class="ve-cip" asp-controller="Account" asp-action="BirimSec"
       title="Aktif birim: @Model.AktifBirimAdi — değiştirmek için tıklayın">
        <i class="bi bi-diagram-2" style="color: var(--ve-metin-3)"></i>
        <span class="ve-cip-etiket">Birim</span>
        <span class="ve-cip-ad">@Model.AktifBirimAdi</span>
        <i class="bi bi-arrow-left-right" style="font-size: 12px; color: var(--ve-metin-4)"></i>
    </a>
}
else
{
    <a class="ve-cip ve-cip--uyari" asp-controller="Account" asp-action="BirimSec">
        <i class="bi bi-exclamation-triangle"></i>
        <span>Birim seçiniz</span>
    </a>
}
