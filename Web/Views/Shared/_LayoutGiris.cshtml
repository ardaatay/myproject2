@{
    var ayar = UygulamaAyarlariOptions.Value;
    var genis = ViewData["GirisGenisMi"] as bool? ?? false;
}

<!DOCTYPE html>
<html lang="@ayar.Kultur">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - @ayar.UygulamaAdi</title>
    <link rel="icon" href="@ayar.LogoYolu"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>

<main class="ve-giris">

    <aside class="ve-giris-marka">
        <span class="ve-giris-desen" aria-hidden="true"></span>

        <div style="display: flex; align-items: center; gap: 12px">
            <img src="@ayar.LogoYolu" alt="" width="38" height="38" style="border-radius: 9px"/>
            <span style="font-size: 18px; font-weight: 600; letter-spacing: -.01em">@ayar.UygulamaAdi</span>
        </div>

        <h1 class="ve-giris-slogan">Kurumun bilgi varlıkları tek yerde.</h1>
        <p class="ve-giris-aciklama">
            Ağ ve sistemlerden basılı belgelere kadar her varlığı sahibi, konumu ve
            gizlilik sınıfıyla birlikte kayıt altında tutun.
        </p>

        <div style="margin-top: 44px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,.16); display: flex; flex-wrap: wrap; gap: 10px 20px; font-size: 13px; color: var(--ve-aksan-200)">
            <span><i class="bi bi-hdd-network"></i> Ağ ve sistemler</span>
            <span><i class="bi bi-window-stack"></i> Uygulamalar</span>
            <span><i class="bi bi-file-earmark-text"></i> Bilgi varlıkları</span>
            <span><i class="bi bi-shield-lock"></i> Kriptografi envanteri</span>
        </div>
    </aside>

    <div class="ve-giris-form">
        <div class="ve-giris-kutu" style="@(genis ? "max-width: 560px" : "")">
            <div class="ve-giris-mobil-marka">
                <img src="@ayar.LogoYolu" alt="" width="34" height="34"/>
                <span>@ayar.UygulamaAdi</span>
            </div>
            @RenderBody()
        </div>
    </div>
</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
