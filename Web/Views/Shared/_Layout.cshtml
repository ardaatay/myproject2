@{
    var ayar = UygulamaAyarlariOptions.Value;

    // Başlık ve logo kurum kaydından gelir; kayıt boşsa uygulama ayarlarına düşer.
    var kimlik = await KurumBilgileriService.GorunenKimlikAsync();

    var yTeknik = await AuthorizationService.YetkiliMi(User, Yetkiler.TeknikVarlikListele);
    var yBilgi = await AuthorizationService.YetkiliMi(User, Yetkiler.BilgiVarlikListele);
    var yYonet = await AuthorizationService.YetkiliMi(User, Yetkiler.SistemYonet);

    var aktifDenetleyici = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    // Kenar menü. Her öge: (görünen ad, denetleyici, ikon).
    var teknikOgeler = new[]
    {
        ("Ağ ve Sistemler", "AgveSistemler", "bi-hdd-network"),
        ("Uygulamalar", "Uygulamalar", "bi-window-stack"),
        ("Taşınabilir Cihaz ve Ortamlar", "TasinabilirCihazveOrtamlar", "bi-laptop"),
        ("IoT Cihazları", "IoTCihazlari", "bi-cpu"),
        ("Fiziksel Mekanlar", "FizikselMekanlar", "bi-building"),
        ("Personel", "Personeller", "bi-people"),
        ("Kriptografi Envanteri", "KriptografiEnvanterleri", "bi-shield-lock")
    };

    var bilgiOgeler = new[]
    {
        ("Basılı Bilgiler", "BasiliBilgiler", "bi-printer"),
        ("Elektronik Bilgiler", "ElektronikBilgiler", "bi-file-earmark-text"),
        ("Veritabanları", "Veritabanlari", "bi-database"),
        ("Süreçler", "Surecler", "bi-diagram-3"),
        ("E-posta Talepleri", "EpostaTalepleri", "bi-envelope")
    };

    var yonetimOgeler = new[]
    {
        ("Raporlar", "Raporlama", "bi-bar-chart"),
        ("Birimler", "Birimler", "bi-diagram-2"),
        ("Kullanıcılar", "Kullanicilar", "bi-person"),
        ("Roller", "Roller", "bi-person-badge"),
        ("Kullanıcı Rolleri", "KullaniciRoller", "bi-person-check"),
        ("Active Directory", "ActiveDirectory", "bi-diagram-3"),
        ("İşlem Logları", "IslemLoglari", "bi-journal-text"),
        ("Hata Logları", "HataLoglari", "bi-bug"),
        ("Kurum Bilgileri", "KurumBilgileri", "bi-building-gear"),
        ("İlgili Kurumlar", "Kurumlar", "bi-buildings")
    };

    var tanimOgeler = new[]
    {
        ("Anahtar Sorumluları", "AnahtarSorumlulari", "bi-key"),
        ("Bağımlı Varlıklar", "BagimliVarliklar", "bi-link-45deg"),
        ("Bilgi Sınıfları", "BilgiSiniflari", "bi-journal-bookmark"),
        ("Bütünlükler", "Butunlukler", "bi-check-circle"),
        ("Destek Durumları", "DestekDurumlari", "bi-headset"),
        ("Durumlar", "Durumlar", "bi-toggle-on"),
        ("Erişilebilirlikler", "Erisilebilirlikler", "bi-hand-index"),
        ("Etkilenen Kişi Sayıları", "EtkilenenKisiSayilari", "bi-people-fill"),
        ("Gizlilikler", "Gizlilikler", "bi-eye-slash"),
        ("Kategoriler", "Kategoriler", "bi-tags"),
        ("Konumlar", "Konumlar", "bi-geo-alt"),
        ("Kriptoloji Türleri", "KriptolojiTurleri", "bi-lock"),
        ("Kullanım Seviyeleri", "KullanimSeviyeleri", "bi-bar-chart-steps"),
        ("Lisans Takip Sorumluları", "LisansTakipSorumlulari", "bi-card-checklist"),
        ("Sektörel Etkiler", "SektorelEtkiler", "bi-graph-up"),
        ("Yedekleme Sorumluları", "YedeklemeSorumlulari", "bi-hdd"),
        ("Yedekleme Tipleri", "YedeklemeTipleri", "bi-archive")
    };

    // Aktif sayfayı içeren grup açık başlar.
    bool GrupAcik((string Ad, string Denetleyici, string Ikon)[] ogeler) =>
        ogeler.Any(o => string.Equals(o.Denetleyici, aktifDenetleyici, StringComparison.OrdinalIgnoreCase));

    var kullaniciAdi = User.Identity?.Name ?? string.Empty;
    var basHarfler = kullaniciAdi.Length >= 2
        ? kullaniciAdi[..2].ToUpperInvariant()
        : kullaniciAdi.ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="@ayar.Kultur">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - @kimlik.Ad</title>
    <link rel="icon" href="@kimlik.LogoYolu"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>

<header class="ve-ust">
    <button type="button" class="ve-menu-dugmesi" id="menuAcKapa"
            aria-label="Menüyü aç" aria-controls="kenarMenu" aria-expanded="false">
        <i class="bi bi-list" style="font-size: 20px"></i>
    </button>

    <a class="ve-marka" href="/">
        <img src="@kimlik.LogoYolu" alt="" width="30" height="30"/>
        <span>@kimlik.Ad</span>
    </a>

    <div class="ve-ust-sag">
        @await Component.InvokeAsync("AktifBirim")

        <div class="dropdown">
            <button class="ve-cip dropdown-toggle" type="button" id="kullaniciMenusu"
                    data-bs-toggle="dropdown" aria-expanded="false" style="padding: 3px 10px 3px 4px">
                <span class="ve-avatar">@basHarfler</span>
                <span class="ve-cip-ad">@kullaniciAdi</span>
                <i class="bi bi-chevron-down" style="font-size: 12px; color: var(--ve-metin-4)"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="kullaniciMenusu">
                <li class="dropdown-header">@kullaniciAdi</li>
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="SifreDegistir">
                        <i class="bi bi-shield-lock"></i> Şifre değiştir
                    </a>
                </li>
                <li><hr class="dropdown-divider"/></li>
                <li>
                    <a class="dropdown-item" href="/Account/Logout" style="color: var(--ve-hata)">
                        <i class="bi bi-box-arrow-right"></i> Çıkış yap
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>

<nav class="ve-menu" id="kenarMenu" aria-label="Ana menü">
    <a href="/" class="ve-menu-baglanti @(aktifDenetleyici.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "aktif" : "")">
        <i class="bi bi-grid-1x2"></i>
        <span>Genel Bakış</span>
    </a>

    @if (yTeknik)
    {
        <div class="ve-menu-grup">
            <button class="ve-menu-grup-baslik @(GrupAcik(teknikOgeler) ? "" : "collapsed")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#grupTeknik"
                    aria-expanded="@(GrupAcik(teknikOgeler) ? "true" : "false")" aria-controls="grupTeknik">
                <i class="bi bi-chevron-down"></i>
                <span>VARLIKLAR</span>
            </button>
            <div class="collapse @(GrupAcik(teknikOgeler) ? "show" : "")" id="grupTeknik">
                <div class="ve-menu-govde">
                    @foreach (var (ad, denetleyici, ikon) in teknikOgeler)
                    {
                        <a href="/@denetleyici" class="ve-menu-baglanti @(denetleyici.Equals(aktifDenetleyici, StringComparison.OrdinalIgnoreCase) ? "aktif" : "")">
                            <i class="bi @ikon"></i>
                            <span>@ad</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (yBilgi)
    {
        <div class="ve-menu-grup">
            <button class="ve-menu-grup-baslik @(GrupAcik(bilgiOgeler) ? "" : "collapsed")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#grupBilgi"
                    aria-expanded="@(GrupAcik(bilgiOgeler) ? "true" : "false")" aria-controls="grupBilgi">
                <i class="bi bi-chevron-down"></i>
                <span>BİLGİ VARLIKLARI</span>
            </button>
            <div class="collapse @(GrupAcik(bilgiOgeler) ? "show" : "")" id="grupBilgi">
                <div class="ve-menu-govde">
                    @foreach (var (ad, denetleyici, ikon) in bilgiOgeler)
                    {
                        <a href="/@denetleyici" class="ve-menu-baglanti @(denetleyici.Equals(aktifDenetleyici, StringComparison.OrdinalIgnoreCase) ? "aktif" : "")">
                            <i class="bi @ikon"></i>
                            <span>@ad</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (yYonet)
    {
        <div class="ve-menu-grup">
            <button class="ve-menu-grup-baslik @(GrupAcik(yonetimOgeler) ? "" : "collapsed")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#grupYonetim"
                    aria-expanded="@(GrupAcik(yonetimOgeler) ? "true" : "false")" aria-controls="grupYonetim">
                <i class="bi bi-chevron-down"></i>
                <span>YÖNETİM</span>
            </button>
            <div class="collapse @(GrupAcik(yonetimOgeler) ? "show" : "")" id="grupYonetim">
                <div class="ve-menu-govde">
                    @foreach (var (ad, denetleyici, ikon) in yonetimOgeler)
                    {
                        <a href="/@denetleyici" class="ve-menu-baglanti @(denetleyici.Equals(aktifDenetleyici, StringComparison.OrdinalIgnoreCase) ? "aktif" : "")">
                            <i class="bi @ikon"></i>
                            <span>@ad</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="ve-menu-grup">
            <button class="ve-menu-grup-baslik @(GrupAcik(tanimOgeler) ? "" : "collapsed")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#grupTanim"
                    aria-expanded="@(GrupAcik(tanimOgeler) ? "true" : "false")" aria-controls="grupTanim">
                <i class="bi bi-chevron-down"></i>
                <span>TANIM LİSTELERİ</span>
            </button>
            <div class="collapse @(GrupAcik(tanimOgeler) ? "show" : "")" id="grupTanim">
                <div class="ve-menu-govde">
                    @foreach (var (ad, denetleyici, ikon) in tanimOgeler)
                    {
                        <a href="/@denetleyici" class="ve-menu-baglanti @(denetleyici.Equals(aktifDenetleyici, StringComparison.OrdinalIgnoreCase) ? "aktif" : "")">
                            <i class="bi @ikon"></i>
                            <span>@ad</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</nav>

<div class="ve-ortu" id="menuOrtu"></div>

<div class="ve-icerik">
    <div class="container-fluid">
        <input type="hidden" id="errorMessage" value="@(TempData["ErrorMessage"] ?? ViewBag.ErrorMessage ?? "")"/>
        <input type="hidden" id="errorStatusCode" value="@(TempData["ErrorStatusCode"] ?? ViewBag.ErrorStatusCode ?? "")"/>
        <input type="hidden" id="errorReferans" value="@(TempData[Web.Middleware.ExceptionMiddleware.KodAnahtari] ?? ViewBag.HataKodu ?? "")"/>
        <input type="hidden" id="successMessage" value="@(TempData["SuccessMessage"] ?? "")"/>
        @RenderBody()
    </div>

    <footer class="ve-alt">
        © @DateTime.Now.Year @kimlik.Ad
    </footer>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/table-wrapper.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
