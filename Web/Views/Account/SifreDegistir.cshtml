@model Dto.Kullanici.SifreDegistirDto

@{
    ViewData["Title"] = "Şifre Değiştir";
    Layout = "_LayoutGiris";

    // Kural metni yapılandırmadan üretilir; politika değişince bu satır da değişir.
    var politika = UygulamaAyarlariOptions.Value.SifrePolitikasi;
    var kosullar = new List<string>();
    if (politika.BuyukHarfGerekli) kosullar.Add("büyük harf");
    if (politika.KucukHarfGerekli) kosullar.Add("küçük harf");
    if (politika.RakamGerekli) kosullar.Add("rakam");
    if (politika.OzelKarakterGerekli) kosullar.Add("özel karakter");
}

<h1 style="font-size: 25px; font-weight: 600; letter-spacing: -.02em; margin-bottom: 6px">Şifrenizi belirleyin</h1>
<p style="color: var(--ve-metin-3); font-size: 14px; margin-bottom: 26px">
    Yeni şifreniz en az @politika.EnAzUzunluk karakter olmalı@(kosullar.Count > 0
        ? "; " + string.Join(", ", kosullar) + " içermelidir."
        : ".")
</p>

@if (TempData["Uyari"] != null)
{
    <div class="alert alert-warning" role="alert">@TempData["Uyari"]</div>
}

<form asp-action="SifreDegistir" method="post" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="MevcutSifre" class="form-label"></label>
        <input asp-for="MevcutSifre" type="password" class="form-control" autocomplete="current-password"/>
        <span asp-validation-for="MevcutSifre" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="YeniSifre" class="form-label"></label>
        <input asp-for="YeniSifre" type="password" class="form-control" autocomplete="new-password"/>
        <span asp-validation-for="YeniSifre" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="YeniSifreTekrar" class="form-label"></label>
        <input asp-for="YeniSifreTekrar" type="password" class="form-control" autocomplete="new-password"/>
        <span asp-validation-for="YeniSifreTekrar" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary">Şifreyi güncelle</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-link w-100 mt-2">Vazgeç</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
