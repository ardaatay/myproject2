@{
    ViewData["Title"] = "Erişim Reddedildi";
    Layout = "_LayoutGiris";
}

<div class="text-center">
    <i class="bi bi-shield-exclamation text-warning" style="font-size:2.5rem"></i>
    <h2 class="h5 mt-3">Erişim Reddedildi</h2>

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-warning py-2 px-3 small mt-3" role="alert">@TempData["Hata"]</div>
    }
    else
    {
        <p class="text-muted small mt-3">Bu sayfayı görüntüleme yetkiniz bulunmuyor.</p>
    }

    <a asp-action="Login" class="btn btn-primary w-100 mt-3">Giriş sayfasına dön</a>
</div>
