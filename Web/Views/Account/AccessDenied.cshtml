@{
    ViewData["Title"] = "Erişim Reddedildi";
    Layout = "_LayoutGiris";
}

<div style="text-align: center">
    <span style="width: 56px; height: 56px; border-radius: 14px; background: var(--ve-uyari-zemin); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 18px">
        <i class="bi bi-shield-exclamation" style="font-size: 26px; color: var(--ve-uyari)"></i>
    </span>

    <h1 style="font-size: 21px; font-weight: 600; letter-spacing: -.02em; margin-bottom: 8px">Erişim reddedildi</h1>

    @if (TempData["Hata"] != null)
    {
        <p style="color: var(--ve-metin-3); font-size: 13.5px; line-height: 1.6; margin-bottom: 24px">@TempData["Hata"]</p>
    }
    else
    {
        <p style="color: var(--ve-metin-3); font-size: 13.5px; line-height: 1.6; margin-bottom: 24px">
            Bu sayfayı görüntüleme yetkiniz bulunmuyor. Yanlış bir birim üzerinde çalışıyor olabilirsiniz.
        </p>
    }

    <a asp-action="Login" class="btn btn-primary">Giriş sayfasına dön</a>
</div>
