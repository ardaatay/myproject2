@using Dto.Rapor
@{
    ViewData["Title"] = "Genel Bakış";

    var kategoriler = new (string Ad, string Denetleyici, string Ikon, int Sayi)[]
    {
        ("Ağ ve Sistemler", "AgveSistemler", "bi-hdd-network", (int)ViewBag.AgveSistemlerSayisi),
        ("Uygulamalar", "Uygulamalar", "bi-window-stack", (int)ViewBag.UygulamalarSayisi),
        ("Taşınabilir Cihaz ve Ortamlar", "TasinabilirCihazveOrtamlar", "bi-laptop", (int)ViewBag.TasinabilirCihazlarSayisi),
        ("IoT Cihazları", "IoTCihazlari", "bi-cpu", (int)ViewBag.IoTCihazlariSayisi),
        ("Fiziksel Mekanlar", "FizikselMekanlar", "bi-building", (int)ViewBag.FizikselMekanlarSayisi),
        ("Personel", "Personeller", "bi-people", (int)ViewBag.PersonelSayisi)
    };

    var toplamVarlik = kategoriler.Sum(k => k.Sayi);
    var enBuyuk = kategoriler.Max(k => k.Sayi);

    // Bu liste her kategoriden yalnızca son 3 kaydı içerir.
    var sonEklenenler = ViewBag.SonEklenenVarliklar as List<RaporAnasayfa> ?? new List<RaporAnasayfa>();
    var buAyEklenen = (int)ViewBag.BuAyEklenenSayisi;
}

<div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 20px">
    <div>
        <h1 style="margin: 0 0 3px">Genel Bakış</h1>
        <p style="margin: 0; color: var(--ve-metin-3); font-size: 13px">
            Aktif biriminizde ve alt birimlerinde kayıtlı varlıkların güncel durumu.
        </p>
    </div>
    <a asp-controller="Raporlama" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-bar-chart"></i> Raporlar
    </a>
</div>

<!-- Özet kutuları -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100 mb-0">
            <div class="card-body">
                <div class="ve-istatistik-etiket">Toplam varlık</div>
                <div class="ve-istatistik-sayi">@toplamVarlik.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 mb-0">
            <div class="card-body">
                <div class="ve-istatistik-etiket">Bu ay eklenen</div>
                <div class="ve-istatistik-sayi" style="color: var(--ve-basari)">@buAyEklenen.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 mb-0">
            <div class="card-body">
                <div class="ve-istatistik-etiket">Aktif kullanıcı</div>
                <div class="ve-istatistik-sayi">@ViewBag.AktifKullaniciSayisi</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 mb-0">
            <div class="card-body">
                <div class="ve-istatistik-etiket">Toplam giriş</div>
                <div class="ve-istatistik-sayi">@ViewBag.ToplamGirisSayisi</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Kategori dağılımı -->
    <div class="col-12 col-xl-7">
        <div class="card h-100 mb-0">
            <div class="card-header">
                <div>
                    <div>Kategoriye göre varlık dağılımı</div>
                    <div style="font-size: 12px; font-weight: 400; color: var(--ve-metin-3); margin-top: 1px">
                        Toplam @toplamVarlik.ToString("N0") kayıt
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (toplamVarlik == 0)
                {
                    <div class="ve-bos">
                        <i class="bi bi-inbox"></i>
                        Henüz varlık kaydı yok.
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 14px">
                        @foreach (var k in kategoriler.OrderByDescending(x => x.Sayi))
                        {
                            var oran = enBuyuk == 0 ? 0 : (int)Math.Round(k.Sayi * 100.0 / enBuyuk);
                            <a href="/@k.Denetleyici" style="display: block; color: inherit">
                                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px">
                                    <i class="bi @k.Ikon" style="color: var(--ve-metin-4); font-size: 15px"></i>
                                    <span style="font-size: 13px; color: var(--ve-metin-2)">@k.Ad</span>
                                    <span class="ve-mono" style="margin-left: auto; font-size: 13px; font-weight: 500; color: var(--ve-metin)">@k.Sayi.ToString("N0")</span>
                                </div>
                                <div class="ve-cubuk-iz">
                                    <div class="ve-cubuk" style="width: @(oran)%"></div>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Son eklenenler -->
    <div class="col-12 col-xl-5">
        <div class="card h-100 mb-0">
            <div class="card-header">
                <div>
                    <div>Son eklenen varlıklar</div>
                    <div style="font-size: 12px; font-weight: 400; color: var(--ve-metin-3); margin-top: 1px">
                        Her kategoriden en son eklenenler
                    </div>
                </div>
            </div>

            @if (sonEklenenler.Count == 0)
            {
                <div class="card-body">
                    <div class="ve-bos">
                        <i class="bi bi-inbox"></i>
                        Henüz varlık eklenmemiş.
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                        <tr>
                            <th>Varlık sahibi</th>
                            <th>Kategori</th>
                            <th>Tarih</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var varlik in sonEklenenler.Take(8))
                        {
                            <tr>
                                <td style="font-weight: 500; color: var(--ve-metin)">@varlik.VarlikSahibi</td>
                                <td>@varlik.Kategori</td>
                                <td class="ve-mono" style="color: var(--ve-metin-3); white-space: nowrap">@varlik.EklenmeTarihi.ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer" style="font-size: 12.5px; color: var(--ve-metin-3); display: flex; gap: 8px; align-items: center">
                    <i class="bi bi-info-circle"></i>
                    Tüm kayıtlar için sol menüdeki kategori sayfalarını kullanın.
                </div>
            }
        </div>
    </div>
</div>
