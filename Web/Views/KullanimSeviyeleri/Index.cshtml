@model IEnumerable<Dto.KullanimSeviyesi.ListKullanimSeviyesiDto>

@{
	ViewData["Title"] = "Kullanım Seviyesi";
}

<div class="container-fluid">
	<h1 class="mt-4">Kullanım Seviyesi Listesi</h1>
	<div class="card mb-4">
		<div class="card-header">
			<a asp-action="Create" class="btn btn-primary">Yeni Kullanım Seviyesi Ekle</a>
		</div>
		<div class="card-body">
			<div class="table-responsive">
				<table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
					<thead>
						<tr>
							<th class="col-md-2">İşlemler</th>
							<th>Ad</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							<tr>
								<td>
									<div class="btn-group" role="group" aria-label="İşlemler">
										<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil-square"></i></a>
										<button type="button" class="btn btn-danger btn-sm" onclick="deleteRecord('@Url.Action("Delete")/@item.Id')"><i class="bi bi-trash"></i></button>
									</div>
								</td>
								<td>@item.Ad</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>


		$(document).ready(function () {
			$('#dataTable').DataTable();
		});
	</script>
} 