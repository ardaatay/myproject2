@model List<Dto.Birim.ListBirimDto>

@{
	ViewData["Title"] = "Birimler";
}

<div class="container-fluid">
	<h1 class="mt-4">Birim Ağacı</h1>

	<div class="card mb-4">
		<div class="card-header d-flex justify-content-between align-items-center">
			<a asp-action="Create" class="btn btn-primary">
				<i class="bi bi-plus-lg me-1"></i> Yeni Birim
			</a>
			<span class="text-muted small">@Model.Count birim</span>
		</div>
		<div class="card-body">
			@if (Model.Count == 0)
			{
				<p class="text-muted mb-0">Henüz birim tanımlanmamış.</p>
			}
			else
			{
				<div class="table-responsive">
					<table class="table table-bordered align-middle" width="100%" cellspacing="0">
						<thead>
						<tr>
							<th class="col-md-2">İşlemler</th>
							<th>Birim</th>
							<th class="col-md-1">Kod</th>
							<th class="col-md-1">Sıra</th>
							<th class="col-md-1">Durum</th>
						</tr>
						</thead>
						<tbody>
						@foreach (var item in Model)
						{
							<tr class="@(item.Durum ? "" : "table-secondary")">
								<td>
									<div class="btn-group" role="group" aria-label="İşlemler">
										<a asp-action="Create" asp-route-ustId="@item.Id"
										   class="btn btn-outline-secondary btn-sm" title="Alt birim ekle">
											<i class="bi bi-plus-lg"></i>
										</a>
										<a asp-action="Edit" asp-route-id="@item.Id"
										   class="btn btn-primary btn-sm" title="Düzenle">
											<i class="bi bi-pencil-square"></i>
										</a>
										@if (item.Durum)
										{
											<button type="button" class="btn btn-danger btn-sm" title="Pasife al"
											        onclick="durumDegistir(@item.Id, false)">
												<i class="bi bi-slash-circle"></i>
											</button>
										}
										else
										{
											<button type="button" class="btn btn-success btn-sm" title="Aktif et"
											        onclick="durumDegistir(@item.Id, true)">
												<i class="bi bi-check-lg"></i>
											</button>
										}
									</div>
								</td>
								<td>
									@* Girinti hiyerarşiyi gösterir; seviye 0 kök birimdir. *@
									<span style="display:inline-block; width:@(item.Seviye * 24)px"></span>
									@if (item.Seviye > 0)
									{
										<i class="bi bi-arrow-return-right text-muted me-2"></i>
									}
									<span class="@(item.Seviye == 0 ? "fw-semibold" : "")">@item.Ad</span>
								</td>
								<td>@item.Kod</td>
								<td>@item.Sira</td>
								<td>
									@if (item.Durum)
									{
										<span class="badge bg-success">Aktif</span>
									}
									else
									{
										<span class="badge bg-secondary">Pasif</span>
									}
								</td>
							</tr>
						}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
</div>

<form id="durumFormu" method="post" asp-action="Delete" class="d-none">
	@Html.AntiForgeryToken()
	<input type="hidden" name="id" id="durumBirimId"/>
</form>

@section Scripts {
	<script>
		function durumDegistir(id, aktifEdiliyor) {
			Swal.fire({
				title: 'Emin misiniz?',
				text: aktifEdiliyor
					? 'Bu birimi aktif etmek istediğinizden emin misiniz?'
					: 'Bu birimi pasife almak istediğinizden emin misiniz?',
				icon: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#3085d6',
				cancelButtonColor: '#d33',
				confirmButtonText: aktifEdiliyor ? 'Evet, aktif et' : 'Evet, pasife al',
				cancelButtonText: 'İptal'
			}).then((result) => {
				if (result.isConfirmed) {
					document.getElementById('durumBirimId').value = id;
					document.getElementById('durumFormu').submit();
				}
			});
		}
	</script>
}
