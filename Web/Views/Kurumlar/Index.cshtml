@model IEnumerable<Dto.Kurum.ListKurumDto>

@{
	ViewData["Title"] = "Kurumlar";
}

<div class="container-fluid">
	<h1 class="mt-4">Kurumlar Listesi</h1>
	<div class="card mb-4">
		<div class="card-header">
			<a asp-action="Create" class="btn btn-primary">Yeni Ekle</a>
		</div>
		<div class="card-body">
			<div class="table-responsive">
				<table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
					<thead>
					<tr>
						<th class="col-md-2">İşlemler</th>
						<th>Ad</th>
						<th>Durum</th>
					</tr>
					</thead>
					<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td>
								<div class="btn-group" role="group" aria-label="İşlemler">
									<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm"><i
											class="fas fa-edit"></i></a>

									@if (item.Durum)
									{
										<button type="button" class="btn btn-danger btn-sm"
										        onclick="deleteRecord('@Url.Action("Delete")/@item.Id')">
											<i class="fas fa-trash"></i></button>
									}
									else
									{
										<button type="button" class="btn btn-success btn-sm"
										        onclick="activeItem(@item.Id)">
											<i class="fas fa-trash"></i></button>
									}
								</div>
							</td>
							<td>@item.Ad</td>
							<td>
								@if (item.Durum)
								{
									<span>Aktif</span>
								}
								else
								{
									<span>Pasif</span>
								}
							</td>
						</tr>
					}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>


		function activeItem(id) {
			Swal.fire({
				title: 'Emin misiniz?',
				text: "Bu kaydı aktif etmek istediğinizden emin misiniz?",
				icon: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#3085d6',
				cancelButtonColor: '#d33',
				confirmButtonText: 'Evet, aktif et!',
				cancelButtonText: 'İptal'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: '@Url.Action("Delete")/' + id,
						type: 'POST',
						success: function () {
							Swal.fire({
								title: 'Aktif Edildi!',
								text: 'Kayıt başarıyla aktif edildi.',
								icon: 'success',
								showConfirmButton: false,
								timer: 1500
							}).then(() => {
								window.location.reload();
							});
						},
						error: function () {
							Swal.fire({
								title: 'Hata!',
								text: 'Aktif etme işlemi sırasında bir hata oluştu.',
								icon: 'error',
								confirmButtonText: 'Tamam'
							});
						}
					});
				}
			});
		}

		$(document).ready(function () {
			$('#dataTable').DataTable({
				language: {
					url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json'
				}
			});
		});
	</script>
} 