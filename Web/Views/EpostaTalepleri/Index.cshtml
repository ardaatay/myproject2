@model IEnumerable<Dto.EpostaTalep.ListEpostaTalepDto>;

@{
	ViewData["Title"] = "Eposta Talepleri";

	var yGoruntule = await AuthorizationService.YetkiliMi(User, Yetkiler.EpostaTalepListele);
	var yDuzenle = await AuthorizationService.YetkiliMi(User, Yetkiler.EpostaTalepYonet);
	var yOlustur = await AuthorizationService.YetkiliMi(User, Yetkiler.EpostaTalepYonet);
	var yYonet = await AuthorizationService.YetkiliMi(User, Yetkiler.SistemYonet);
}

<div class="container-fluid">
	<h1 class="mt-4">Eposta Talep Listesi</h1>
	<div class="card mb-4">
		<div class="card-header">
			@if (yOlustur)
			{
				<a asp-action="Create" class="btn btn-primary">Yeni Ekle</a>
			}
			
			<a href="javascript:void(0);" id="downloadExcelBtn" class="btn btn-success">
				<i class="bi bi-file-earmark-spreadsheet"></i> Excel İndir
			</a>
		</div>
		<div class="card-body">
			<div class="custom-search mb-3">
				<div class="row">
					<div class="col-md-1">
						<label class="form-label">Arama:</label>
					</div>
					<div class="col-md-2">
						<input type="text" id="customSearch" placeholder="Ara..." class="form-control">
					</div>
				</div>
				<div class="row mt-3">
					<div class="col-md-1">
					</div>
					<div class="col-md-2">
						<input type="button" value="Ara" id="searchButton" class="btn btn-primary">
					</div>
				</div>
			</div>
			<div class="dual-scroll-container">
				<div class="scroll-bar-top">
					<input type="range" id="leftScrollBar" min="0" max="100" value="0" class="form-range">
				</div>
				<div id="tableWrapper" class="table-wrapper">
					<table class="table table-bordered table-hover" id="dataTable">
						<thead>
						<tr>
							<th>İşlemler</th>
							<th>Kurum</th>
							<th>Üçüncü Taraf Firma veya Kişi</th>
							<th>Talep Edilen E-Posta Hesabı</th>
							<th>Talep Eden Kullanıcı</th>
							<th>Talep Eden Birim</th>
							<th>Talep Süresi</th>
							<th>Durum</th>
							<th>Dosya</th>
						</tr>
						</thead>
					</table>
				</div>
				<div class="scroll-bar-bottom">
					<input type="range" id="rightScrollBar" min="0" max="100" value="0" class="form-range">
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function () {
			/* Define global variables for shared scripts if needed */
			const deleteUrlBase = '@Url.Action("Delete")';
			const deleteDatabaseUrlBase = '@Url.Action("DeleteDatabase")';

			const yGoruntule = @yGoruntule.ToString().ToLower();
			const yDuzenle = @yDuzenle.ToString().ToLower();
			const yOlustur = @yOlustur.ToString().ToLower();
			const yYonet = @yYonet.ToString().ToLower();


			// Güvenli indirme için temel URL
			const downloadBaseUrl = '@Url.Action("Download", "EpostaTalepleri")';

			const table = $('#dataTable').DataTable({
				stateSave: true,
				stateDuration: 60 * 60 * 24,
				processing: true,
				serverSide: true,
				ajax: {
					url: '@Url.Action("GetEpostaTalepleri", "EpostaTalepleri")',
					type: 'POST',
					data: function (d) {
						return d;
					}
				},
				dom: 'lrtip',
				language: {
					url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json'
				},
				columns: [
					{
						data: null,
						orderable: false,
						render: function (data, type, row) {
							let buttons = '';

							if (yGoruntule) {
								buttons += `<a href="EpostaTalepleri/Detail/${row.id}" class="btn btn-secondary btn-sm me-1" title="Detay"><i class="bi bi-info-circle"></i></a>`;

								if (isBgysAdmin) {
									buttons += `<a href="EpostaTalepleri/Edit/${row.id}" class="btn btn-primary btn-sm me-1" title="Güncelle"><i class="bi bi-pencil-square"></i></a>`;
									buttons += `<a href="EpostaTalepleri/Copy/${row.id}" class="btn btn-warning btn-sm me-1" title="Kopyala"><i class="bi bi-copy"></i></a>`;
									buttons += `<button class="btn btn-danger btn-sm me-1" onclick="deleteRecord('${deleteUrlBase}/${row.id}')" title="Sil"><i class="bi bi-trash"></i></button>`;
								}

								if (yYonet) {
									buttons += `<button class="btn btn-danger btn-sm" onclick="deleteDatabaseRecord('${deleteDatabaseUrlBase}/${row.id}')" title="Kalıcı Sil"><i class="bi bi-database"></i></button>`;
								}
							}

							return `<div class="btn-group">${buttons}</div>`;
						}
					},
					{data: 'kurumAd'},
					{data: 'ucuncuTaraf'},
					{data: 'talepEdilen'},
					{data: 'talepEden'},
					{data: 'talepNedeni'},
					{data: 'talepSuresi'},
					{data: 'durum'},
					{
						data: 'dosyaYolu',
						render: function (data, type, row) {
							if (data) {
								return `<a href="${downloadBaseUrl}/${row.id}" class="btn btn-info btn-sm"><i class="bi bi-file-earmark-arrow-down"></i> İndir</a>`;
							} else {
								return 'Dosya yok';
							}
						}
					}
				],
				// DataTables'ın kendi stil uygulamasını devre dışı bırakalım
				"bAutoWidth": false,
				"ordering": true,
			});

			$('#dataTable tbody').on('click', 'tr', function () {
				if ($(this).hasClass('selected')) {
					$(this).removeClass('selected');
				} else {
					table.$('tr.selected').removeClass('selected');
					$(this).addClass('selected');
				}
			});

			$('<style>')
				.prop('type', 'text/css')
				.html(`
		            #dataTable tbody tr.selected {
		                background-color: #ffff99 !important;
		            }
		        `)
				.appendTo('head');

			$('#searchButton').on('click', function () {
				var searchValue = $('#customSearch').val().toLowerCase();
				table.search(searchValue).draw();
			});

			$('#downloadExcelBtn').on('click', function () {
				// Arama ve filtreleme değerlerini al
				const searchValue = $('#customSearch').val();

				// Dosyayı indir
				window.location.href = '@Url.Action("DownloadExcel", "EpostaTalepleri")?search=' + encodeURIComponent(searchValue);
			});
		});
	</script>
}