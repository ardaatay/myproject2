@model Dto.Kullanici.KullaniciRolAtamaDto

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>@Model.KullaniciAdi İçin Rol Atama</h2>

<form asp-action="RolAta" method="post">
    <input type="hidden" asp-for="KullaniciId" />
    <input type="hidden" asp-for="KullaniciAdi" />

    <div class="form-group">
        <label>Roller</label>
        <div class="row">
            @if (Model?.Roller != null)
            {
                @for (int i = 0; i < Model.Roller.Count; i++)
                {
                    <div class="col-md-4">
                        <div class="form-check">
                            <input type="hidden" asp-for="@Model.Roller[i].RolId" />
                            <input type="hidden" asp-for="@Model.Roller[i].RolAdi" />
                            <input type="checkbox" class="form-check-input" asp-for="@Model.Roller[i].Secildi" />
                            <label class="form-check-label" asp-for="@Model.Roller[i].Secildi">
                                @Model.Roller[i].RolAdi
                            </label>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-success">Rolleri Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </div>
</form>
